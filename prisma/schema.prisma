generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PricingInterval {
  month
  year
  custom
}

enum PricingAudience {
  individual
  family
  school
  organisation
}

enum SchoolStatus {
  pilot
  active
  suspended
  archived
}

enum SchoolTeacherStatus {
  invited
  active
  suspended
  archived
}

enum SchoolTeacherRole {
  owner
  admin
  teacher
  support
  staff_observer
  finance
}

enum SchoolStudentStatus {
  active
  archived
  transferred
}

enum SchoolBillingInterval {
  month
  year
  custom
}

enum SchoolInviteType {
  teacher
  school_admin
  parent
}

enum GaAudioSourceType {
  AI_GENERATED
  AI_GENERATED_SONG
  ADMIN_UPLOADED
  PRONUNCIATION_REFERENCE
  STUDENT_RECORDING
  FUTURE_NATIVE_SPEAKER
  NATIVE_VERIFIED
}

enum GaAudioReviewStatus {
  DRAFT
  AI_GENERATED
  APPROVED_FOR_EARLY_LEARNING
  NEEDS_NATIVE_REVIEW
  NATIVE_VERIFIED
  REJECTED
  REPLACED
}

enum GaAudioApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REPLACED
}

enum GaAudioQualityStatus {
  UNCHECKED
  GOOD
  TOO_QUIET
  TOO_LOUD
  NEEDS_CLEANUP
}

enum GaAudioEnhancementStatus {
  NOT_APPLIED
  QUEUED
  APPLIED
  FAILED
  BYPASSED
}

enum GaReferencePermissionStatus {
  UNKNOWN
  REFERENCE_ONLY
  LICENSED
}

enum GaStudentRecordingReviewStatus {
  PENDING
  REVIEWED
  NEEDS_REPEAT
  FLAGGED
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  name                    String?
  role                    String    @default("parent")
  trialSessionsUsed       Int       @default(0)
  pinHash                 String?
  parentPinFailedAttempts Int       @default(0)
  parentPinLockedUntil    DateTime?
  parentPinUpdatedAt      DateTime?
  activeChildId           String?
  consentVersion          String?
  consentAcceptedAt       DateTime?
  consentWithdrawnAt      DateTime?
  passwordResetToken      String?
  passwordResetExpires    DateTime?

  children                          ChildProfile[]
  adminProfile                      AdminUser?
  auditLogs                         AuditLog[]
  subscriptions                     Subscription[]
  passwordResetTokens               PasswordResetToken[]
  ownedSchools                      School[]                         @relation("SchoolOwner")
  teachingLinks                     SchoolTeacher[]
  schoolLogins                      SchoolLoginHistory[]
  schoolAccessLogs                  SchoolAccessLog[]
  licenceEvents                     LicenceEvent[]
  safeguardingIncidents             SafeguardingIncident[]           @relation("SafeguardingReportedBy")
  consumedSchoolInviteTokens        SchoolInviteToken[]              @relation("SchoolInviteConsumedBy")
  createdSchoolInviteTokens         SchoolInviteToken[]              @relation("SchoolInviteCreatedBy")
  parentSchoolLinks                 ParentSchoolLink[]               @relation("ParentSchoolLinks")
  trustMemberships                  TrustAdminMembership[]
  notificationPreferences           NotificationPreference[]
  schoolProvisioningJobs            SchoolProvisioningJob[]          @relation("ProvisioningRequestedBy")
  schoolProvisioningStepRuns        SchoolProvisioningStepRun[]      @relation("ProvisioningStepActor")
  notificationDeliveries            NotificationDelivery[]           @relation("NotificationDeliveredBy")
  authSessions                      AuthSession[]
  updatedCommunicationPreferences   SchoolCommunicationPreference[]  @relation("CommunicationPreferenceUpdatedBy")
  schoolCommunicationLogs           SchoolCommunicationLog[]         @relation("SchoolCommunicationActor")
  ownedSafeguardingEscalations      SafeguardingIncident[]           @relation("SafeguardingEscalationOwner")
  safeguardingWorkflowEvents        SafeguardingWorkflowEvent[]      @relation("SafeguardingWorkflowActor")
  safeguardingEvidenceUploads       SafeguardingEvidenceAttachment[] @relation("SafeguardingEvidenceUploadedBy")
  parentProfile                     ParentProfile?
  parentPinResetTokens              ParentPinResetToken[]
  homeworkAuditLogs                 HomeworkAuditLog[]
  gaAudioAssetsCreated              GaAudioAsset[]                   @relation("GaAudioAssetCreatedBy")
  gaAudioAssetsApproved             GaAudioAsset[]                   @relation("GaAudioAssetApprovedBy")
  gaAudioAssetsRejected             GaAudioAsset[]                   @relation("GaAudioAssetRejectedBy")
  gaAudioAssetsDeleted              GaAudioAsset[]                   @relation("GaAudioAssetDeletedBy")
  gaPronunciationReferencesCreated  GaPronunciationReference[]       @relation("GaReferenceCreatedBy")
  gaPronunciationReferencesReviewed GaPronunciationReference[]       @relation("GaReferenceReviewedBy")
  gaStudentRecordingReviews         GaStudentRecording[]             @relation("GaStudentRecordingReviewedBy")
  gaSongLessonsCreated              GaSongLesson[]                   @relation("GaSongLessonCreatedBy")
  gaSongLessonsApproved             GaSongLesson[]                   @relation("GaSongLessonApprovedBy")
  gaAudioAuditLogs                  GaAudioAuditLog[]                @relation("GaAudioAuditPerformedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passwordResetToken])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ParentPinResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ChildProfile {
  id       String @id
  parentId String
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  name      String
  avatar    String?
  age       Int?
  yearGroup String?

  stars  Int @default(0)
  xp     Int @default(0)
  coins  Int @default(0)
  level  Int @default(1)
  streak Int @default(0)

  selectedVoice      String  @default("friendly_coach")
  selectedTheme      String  @default("default")
  archived           Boolean @default(false)
  snapshotJson       String?
  coachingMemoryJson String?

  progressRecords       ProgressRecord[]
  rewards               ChildReward[]
  walletTransactions    WalletTransaction[]
  questionHistory       QuestionHistory[]
  weakAreas             WeakArea[]
  assignments           Assignment[]
  attempts              Attempt[]
  homeworkBatches       HomeworkBatch[]
  homeworkAnswers       HomeworkAnswer[]
  studentSkills         StudentSkill[]
  schoolLinks           SchoolStudent[]
  safeguardingAlerts    SchoolSafeguardingAlert[]
  safeguardingIncidents SafeguardingIncident[]
  studentProfile        StudentProfile?
  certificates          Certificate[]
  skillMasteries        SkillMastery[]
  masteryCheckResults   MasteryCheckResult[]
  coachInteractionLogs  CoachInteractionLog[]
  gaLessonProgress      GaStudentLessonProgress[]
  gaStudentRecordings   GaStudentRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                  String
  whatsappNumber         String?
  address                String?
  country                String?
  timezone               String?
  parentRole             String?   @default("parent")
  status                 String    @default("active") // active | pending | suspended
  emailVerified          Boolean   @default(false)
  smsConsent             Boolean   @default(false)
  whatsappConsent        Boolean   @default(false)
  emailConsent           Boolean   @default(false)
  numberOfChildren       Int?
  preferredLearningFocus String?
  schoolType             String?
  curriculum             String?
  trialStatus            String?   @default("none")
  subscriptionPlan       String?
  stripeCustomerId       String?
  paystackCustomerId     String?
  forcePasswordReset     Boolean   @default(false)
  mfaEnabled             Boolean   @default(false)
  lastLoginAt            DateTime?
  deviceTrackingJson     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model TrialAccount {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailConsent        Boolean   @default(false)
  activitiesRemaining Int       @default(10)
  spellingRemaining   Int       @default(4)
  readingRemaining    Int       @default(3)
  mathsRemaining      Int       @default(3)
  trialStartedAt      DateTime
  trialExpiresAt      DateTime
  lastActiveAt        DateTime
  activitiesCompleted Int       @default(0)
  wordsMastered       Int       @default(0)
  subjectUsageJson    String?
  subjectsUsed        String?
  lastActivity        String?
  streakCount         Int       @default(0)
  convertedToAccount  Boolean   @default(false)
  upgradedAt          DateTime?
  welcomeEmailSentAt  DateTime?
  continueEmailSentAt DateTime?
  progressEmailSentAt DateTime?
  upgradeEmailSentAt  DateTime?
  lastEmailSentAt     DateTime?
  sessionTokenHash    String?
  sessionIssuedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([trialExpiresAt])
  @@index([lastActiveAt])
  @@index([convertedToAccount])
}

model StudentProfile {
  id                    String       @id @default(cuid())
  childId               String       @unique
  child                 ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  keyStageLevel         String?
  learningLevel         String?
  senSupportNeeds       String?
  readingLevel          String?
  weakAreasText         String?
  voiceProfile          String?
  aiLearningProfileJson String?
  guardianPermissions   String?
  schoolInformation     String?
  subjectFocus          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Certificate {
  id                String       @id @default(cuid())
  studentId         String
  student           ChildProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateNumber String       @unique
  verificationCode  String       @unique
  idempotencyKey    String       @unique
  certificateType   String
  title             String
  awardReason       String?
  subject           String?
  level             String?
  yearGroup         String?
  score             Float?
  issuedAt          DateTime
  status            String       @default("issued")
  metadataJson      String?
  awardSourceType   String?
  awardSourceId     String?
  rank              Int?
  rankLabel         String?
  competitionName   String?
  testName          String?
  tiedRank          Boolean?
  rankingMethod     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([studentId])
  @@index([certificateType])
  @@index([awardSourceType, awardSourceId])
}

model ProgressRecord {
  id      String       @id @default(cuid())
  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  activityType String
  activityName String

  starsEarned Int @default(0)
  xpEarned    Int @default(0)
  coinsEarned Int @default(0)

  score      Float?
  correct    Boolean?
  difficulty Int?
  notes      String?
  accuracy   Int?
  completed  Boolean  @default(false)

  createdAt DateTime @default(now())
}

model QuestionHistory {
  id      String       @id @default(cuid())
  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  activityType      String
  questionId        String
  answeredCorrectly Boolean
  attempts          Int     @default(1)

  createdAt DateTime @default(now())

  @@unique([childId, questionId])
}

model RewardItem {
  id          String @id @default(cuid())
  name        String
  description String
  category    String

  cost        Int
  unlockLevel Int @default(1)

  imageUrl String?
  isActive Boolean @default(true)

  childRewards ChildReward[]

  createdAt DateTime @default(now())
}

model AIContentCache {
  id                 String       @id @default(cuid())
  contentType        String // "spelling" | "math" | "reading"
  level              Int
  topic              String       @default("")
  contentJson        String // JSON array of generated items
  usedCount          Int          @default(0)
  status             String       @default("draft") // draft | reviewed | approved | published
  reviewedAt         DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  createdBy          String       @default("system")
  model              String?
  prompt             String?
  keyStage           String?
  yearGroup          String?
  skillFocus         String?
  skills             String? // comma-separated skill codes e.g. "cvc,short_vowels"
  metadataJson       String?
  estimatedCostPence Int          @default(0)
  assignments        Assignment[]

  @@index([contentType, level])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Persistent skill mastery tracking — New → Practising → Developing → Confident → Mastered
// ──────────────────────────────────────────────────────────────────────────

model SkillMastery {
  id String @id @default(cuid())

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  subject    String // "maths" | "reading" | "spelling" | "science" | "english"
  skillFocus String // "linear_equations", "phonics", etc.

  masteryLevel    String    @default("new") // "new" | "practising" | "developing" | "confident" | "mastered"
  confidenceScore Float     @default(0.5)
  attemptCount    Int       @default(0)
  correctCount    Int       @default(0)
  lastAttemptAt   DateTime?
  lastMasteredAt  DateTime?

  masteryCheckResults MasteryCheckResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, subject, skillFocus])
  @@index([childId])
  @@index([masteryLevel])
}

// Track independent mastery check attempts (no hints allowed)
model MasteryCheckResult {
  id String @id @default(cuid())

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  skillId String
  skill   SkillMastery @relation(fields: [skillId], references: [id], onDelete: Cascade)

  questionText   String
  correctAnswer  String
  studentAnswer  String
  hintsUsed      Int     @default(0)
  responseTimeMs Int?
  passed         Boolean

  createdAt DateTime @default(now())

  @@index([childId])
  @@index([skillId, passed])
}

// Track coach interaction history for progressive-help gating
model CoachInteractionLog {
  id String @id @default(cuid())

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  subject      String // "maths" | "reading" | etc.
  skillFocus   String?
  questionText String

  hintLevel      Int
  mode           String // "hint" | "guided_steps" | "full_walkthrough" | "mistake_recovery" | "reveal"
  studentAnswer  String?
  correct        Boolean?
  responseTimeMs Int?

  createdAt DateTime @default(now())

  @@index([childId])
  @@index([subject])
}

model WordProgress {
  id           String   @id @default(cuid())
  studentId    String
  word         String
  length       Int
  pattern      String?
  attempts     Int      @default(0)
  correctCount Int      @default(0)
  status       String   @default("seen")
  mistakeType  String?
  lastSeen     DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([studentId, word])
}

model ApiKeyConfig {
  id             String    @id @default(cuid())
  provider       String    @unique // openai | payment | email | voice | storage
  label          String
  encryptedValue String
  maskedValue    String
  status         String    @default("untested") // untested | connected | failed
  lastTestedAt   DateTime?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum AdminPermission {
  // User Management
  MANAGE_USERS
  MANAGE_ADMINS
  MANAGE_ROLES
  VIEW_AUDIT_LOGS

  // Content & Learning
  MANAGE_CONTENT
  APPROVE_CONTENT
  MANAGE_ASSIGNMENTS
  VIEW_PROGRESS

  // Billing & Subscriptions
  MANAGE_BILLING
  MANAGE_SUBSCRIPTIONS

  // Integrations & API
  MANAGE_INTEGRATIONS
  MANAGE_API_KEYS

  // Platform Settings
  MANAGE_SETTINGS
  MANAGE_BRANDING
  MANAGE_SECURITY

  // Data Operations
  VIEW_REPORTS
  EXPORT_DATA
  ARCHIVE_RECORDS
  DELETE_RECORDS

  // Inbox & Communications
  MANAGE_INBOX
}

model AdminRole {
  id          String      @id @default(cuid())
  name        String      @unique(map: "sqlite_autoindex_AdminRole_2")
  description String?
  permissions String      @default("[]") // JSON array of AdminPermission enum values
  isBuiltIn   Boolean     @default(false)
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AdminUser {
  id                  String     @id @default(cuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId              String?
  role                AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active              Boolean    @default(true)
  title               String?
  lastLoginAt         DateTime?
  lastLoginIpAddress  String?
  lastLoginUserAgent  String?
  isLocked            Boolean    @default(false)
  lockedReason        String?
  lockedUntil         DateTime?
  deletionRequestedAt DateTime?
  deletionRequester   String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Deletion approvals (many-to-one: this admin is the target being deleted)
  deleteApprovalsAsTarget    DeleteApproval[] @relation("DeleteTarget")
  // Deletion approvals (many-to-one: this admin requested the deletion)
  deleteApprovalsAsRequester DeleteApproval[] @relation("DeleteRequester")
  // Deletion approvals (many-to-one: this admin approved the deletion)
  deleteApprovalsAsApprover  DeleteApproval[] @relation("DeleteApprover")

  @@index([active])
  @@index([roleId])
}

model DeleteApproval {
  id                String     @id @default(cuid())
  targetUserId      String
  targetUser        AdminUser  @relation(fields: [targetUserId], references: [id], onDelete: Cascade, name: "DeleteTarget")
  requestedByUserId String
  requestedBy       AdminUser  @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade, name: "DeleteRequester")
  approvedByUserId  String?
  approvedBy        AdminUser? @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull, name: "DeleteApprover")

  entityType        String // "admin_user" | "student" | "parent" | "subscription" | "content" | "api_key"
  entityId          String
  reason            String?
  status            String  @default("pending") // pending | approved | denied | cancelled
  requestIpAddress  String?
  requestUserAgent  String?
  approvalIpAddress String?
  approvalUserAgent String?
  denialReason      String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  deniedAt    DateTime?
  executedAt  DateTime?
  expiresAt   DateTime // Approval expires after 7 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetUserId, status])
  @@index([requestedByUserId, status])
  @@index([entityType, entityId])
  @@index([status, expiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model DictionaryWord {
  id                    String    @id @default(cuid())
  word                  String
  normalizedWord        String
  subject               String
  keyStage              String
  yearGroup             String?
  difficulty            String    @default("easy")
  topic                 String?
  skillFocus            String?
  definitionChild       String
  definitionParent      String?
  exampleSentence       String?
  secondExampleSentence String?
  phonicsPattern        String?
  syllables             String?
  pronunciationHint     String?
  synonyms              String[]
  antonyms              String[]
  relatedWords          String[]
  isTrickyWord          Boolean   @default(false)
  isTopicKeyword        Boolean   @default(false)
  isMathsKeyword        Boolean   @default(false)
  isScienceKeyword      Boolean   @default(false)
  isReadingKeyword      Boolean   @default(false)
  isSpellingKeyword     Boolean   @default(false)
  interventionTags      String[]
  senTags               String[]
  safeguardingTags      String[]
  curriculumTags        String[]
  importSource          String?   @default("manual")
  createdByUserId       String?
  updatedByUserId       String?
  deactivatedByUserId   String?
  deactivatedAt         DateTime?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([normalizedWord, subject, keyStage, yearGroup])
  @@index([normalizedWord])
  @@index([subject])
  @@index([keyStage])
  @@index([yearGroup])
  @@index([subject, keyStage])
  @@index([subject, keyStage, yearGroup])
  @@index([active, subject])
  @@index([active, keyStage])
}

model GaSource {
  id            String   @id @default(cuid())
  sourceName    String
  sourceYear    Int?
  fileName      String?
  fileReference String?
  pageNumber    Int?
  section       String?
  notes         String?
  words         GaWord[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceName])
  @@index([sourceYear])
  @@index([pageNumber])
  @@index([section])
}

model GaCategory {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?
  isActive       Boolean  @default(true)
  isArchived     Boolean  @default(false)
  usedByWordBank Boolean  @default(true)
  usedByLessons  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, isArchived])
  @@index([usedByWordBank, isActive])
  @@index([usedByLessons, isActive])
}

model GaWord {
  id                      String                     @id @default(cuid())
  englishWord             String
  gaWord                  String
  wordType                String
  category                String
  level                   String
  sourceId                String?
  source                  GaSource?                  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourcePage              Int?
  reviewStatus            String                     @default("Pending")
  audioStatus             String                     @default("Not Started")
  quizReady               Boolean                    @default(false)
  storyReady              Boolean                    @default(false)
  notes                   String?
  lessons                 GaLessonWord[]
  quizQuestions           GaQuizQuestion[]
  audioAssets             GaAudioAsset[]
  pronunciationReferences GaPronunciationReference[]
  studentRecordings       GaStudentRecording[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([englishWord, gaWord, sourceId])
  @@index([reviewStatus])
  @@index([category])
  @@index([level])
  @@index([wordType])
  @@index([audioStatus])
  @@index([quizReady])
  @@index([storyReady])
  @@index([sourcePage])
}

model GaLesson {
  id                      String                     @id @default(cuid())
  title                   String
  slug                    String                     @unique
  description             String?
  level                   String
  category                String
  objective               String
  packKey                 String?
  lessonOrder             Int                        @default(0)
  publishStatus           String                     @default("Draft")
  words                   GaLessonWord[]
  activities              GaLessonActivity[]
  quizQuestions           GaQuizQuestion[]
  progress                GaStudentLessonProgress[]
  audioAssets             GaAudioAsset[]
  pronunciationReferences GaPronunciationReference[]
  studentRecordings       GaStudentRecording[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([publishStatus])
  @@index([level])
  @@index([category])
  @@index([packKey, lessonOrder])
}

model GaLessonWord {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    GaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  wordId    String
  word      GaWord   @relation(fields: [wordId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([lessonId, wordId])
  @@index([lessonId, sortOrder])
  @@index([wordId])
}

model GaLessonActivity {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       GaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType String
  title        String
  instructions String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId, sortOrder])
  @@index([activityType])
}

model GaQuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  lesson        GaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  wordId        String?
  word          GaWord?  @relation(fields: [wordId], references: [id], onDelete: Restrict)
  questionType  String
  prompt        String
  optionsJson   String
  correctAnswer String
  explanation   String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lessonId, sortOrder])
