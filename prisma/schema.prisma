  keyStage          String?
  yearGroup         String?
  skillFocus        String
  weaknessType      String
  accuracy          Int
  attemptsCount     Int
  currentDifficulty Int          @default(1)
  lastDetectedAt    DateTime     @default(now())
  status            String       @default("active")
  metadataJson      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([studentId, subject, skillFocus])
  @@index([status])
  @@index([subject, skillFocus])
}

model Assignment {
  id          String         @id @default(cuid())
  studentId   String
  student     ChildProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId   String
  content     AIContentCache @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status      String         @default("assigned")
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([studentId, contentId])
  @@index([studentId, status])
}

model HomeworkBatch {
  id                          String       @id @default(cuid())
  studentId                   String
  student                     ChildProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekStart                   DateTime
  weekEnd                     DateTime
  timezone                    String
  status                      String       @default("GENERATED")
  dueBeforeNextSession        Boolean      @default(true)
  generatedAt                 DateTime     @default(now())
  startedAt                   DateTime?
  submittedAt                 DateTime?
  markedAt                    DateTime?
  completedAt                 DateTime?
  frozenAt                    DateTime?
  sourceCompletedSessionCount Int          @default(0)
  sourceStartedSessionCount   Int          @default(0)
  weaknessSummaryJson         String?
  workloadCapMinutes          Int          @default(0)
  plannedMinutes              Int          @default(0)
  scorePercent                Int?
  recapOnly                   Boolean      @default(false)
  overrideReason              String?
  excusedReason               String?
  extendedDueAt               DateTime?
  cancelledReason             String?
  metadataJson                String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  questions HomeworkQuestion[]
  answers   HomeworkAnswer[]
  auditLogs HomeworkAuditLog[]

  @@unique([studentId, weekStart])
  @@index([studentId, status])
  @@index([weekStart, weekEnd])
}

model HomeworkQuestion {
  id                 String        @id @default(cuid())
  batchId            String
  batch              HomeworkBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order              Int
  subject            String
  topic              String?
  skill              String?
  questionType       String
  promptJson         String
  optionsJson        String?
  expectedAnswerJson String?
  markingType        String        @default("auto")
  required           Boolean       @default(true)
  estimatedMinutes   Int           @default(1)
  difficulty         Int           @default(1)
  frozenAt           DateTime?
  metadataJson       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  answers HomeworkAnswer[]

  @@unique([batchId, order])
  @@index([batchId])
}

model HomeworkAnswer {
  id                  String           @id @default(cuid())
  batchId             String
  batch               HomeworkBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questionId          String
  question            HomeworkQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId           String
  student             ChildProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  draftAnswerJson     String?
  submittedAnswerJson String?
  isAnswered          Boolean          @default(false)
  answeredAt          DateTime?
  submittedAt         DateTime?
  markingStatus       String           @default("not_marked")
  isCorrect           Boolean?
  score               Int?
  feedbackJson        String?
  aiConfidence        Int?
  reviewNeeded        Boolean          @default(false)
  metadataJson        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([batchId, questionId, studentId])
  @@index([studentId, batchId])
  @@index([questionId])
}

model HomeworkAuditLog {
  id           String        @id @default(cuid())
  batchId      String
  batch        HomeworkBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  reason       String?
  metadataJson String?
  createdAt    DateTime      @default(now())

  @@index([batchId, createdAt])
  @@index([actorUserId])
}

model Attempt {
  id             String       @id @default(cuid())
  studentId      String
  student        ChildProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        String
  spellingMode   String?
  keyStage       String?
  yearGroup      String?
  skillFocus     String
  contentId      String?
  assignmentId   String?
  questionText   String?
  answerGiven    String?
  correctAnswer  String?
  correct        Boolean
  responseTimeMs Int
  hintsUsed      Int          @default(0)
  difficulty     Int
  skills         String? // comma-separated skill codes
  createdAt      DateTime     @default(now())

  @@index([studentId, subject, skillFocus])
  @@index([createdAt])
}

model ChildReward {
  id      String       @id @default(cuid())
  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  rewardId String
  reward   RewardItem @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  isEquipped Boolean @default(false)

  purchasedAt DateTime @default(now())

  @@unique([childId, rewardId])
}

model StudentSkill {
  id        String       @id @default(cuid())
  studentId String
  student   ChildProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill     String
  accuracy  Float        @default(0)
  attempts  Int          @default(0)
  correct   Int          @default(0)
  status    String       @default("weak") // weak | improving | mastered
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([studentId, skill])
  @@index([studentId, status])
  @@index([skill])
}

model BrandingSettings {
  id         String   @id @default(cuid())
  siteName   String   @default("StarLiz Academy")
  tagline    String   @default("Learn • Grow • Shine")
  logoUrl    String   @default("/brand/starliz-logo.png")
  iconUrl    String   @default("/brand/starliz-logo.png")
  faviconUrl String   @default("/brand/starliz-logo.png")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Stores the Microsoft Graph OAuth token for the connected admin Outlook inbox
model OutlookToken {
  id              String   @id @default(cuid())
  adminUserId     String   @unique
  microsoftUserId String
  email           String
  displayName     String?
  accessToken     String // encrypted
  refreshToken    String // encrypted
  expiresAt       DateTime
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GeneralSettings {
  id              String   @id @default(cuid())
  appName         String   @default("StarLiz Academy")
  timezone        String   @default("Europe/London")
  locale          String   @default("en-GB")
  supportEmail    String   @default("")
  maintenanceMode Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SecuritySettings {
  id                  String   @id @default(cuid())
  minPasswordLength   Int      @default(8)
  requireUppercase    Boolean  @default(true)
  requireNumber       Boolean  @default(true)
  requireSpecial      Boolean  @default(false)
  sessionTimeoutHours Int      @default(24)
  maxLoginAttempts    Int      @default(5)
  twoFaEnabled        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AIAdaptationSettings {
  id                     String   @id @default(cuid())
  frustrationThreshold   Int      @default(3)
  lowConfidenceThreshold Int      @default(40)
  adaptationEnabled      Boolean  @default(true)
  warmupRequired         Boolean  @default(true)
  shortSessionMins       Int      @default(5)
  normalSessionMins      Int      @default(15)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Sent/received emails tracked in the admin inbox
model AdminEmail {
  id          String   @id @default(cuid())
  adminUserId String
  direction   String // "inbox" | "sent"
  subject     String
  body        String?
  fromAddress String
  toAddress   String
  messageId   String? // Microsoft message ID for threading
  isRead      Boolean  @default(false)
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([adminUserId, direction])
  @@index([adminUserId, isRead])
}

model ParentMessageThread {
  id                String    @id @default(cuid())
  channel           String    @default("whatsapp") // text | whatsapp
  contactAddress    String // e.g. +447700900123 or parent email for in-app
  contactLabel      String?
  parentId          String?
  parentEmail       String?
  unreadCount       Int       @default(0) // admin's unread (inbound from parent)
  parentUnreadCount Int       @default(0) // parent's unread (outbound replies from admin)
  lastMessageAt     DateTime  @default(now())
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages ParentMessage[]

  @@unique([channel, contactAddress])
  @@index([lastMessageAt])
}

model ParentMessage {
  id             String              @id @default(cuid())
  threadId       String
  thread         ParentMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction      String // inbound | outbound
  body           String
  fromAddress    String
  toAddress      String
  providerSid    String?             @unique
  providerStatus String?
  mediaUrlsJson  String?
  actorUserId    String?
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([threadId, createdAt])
  @@index([direction, createdAt])
}

// ─── School: Invite Tokens ─────────────────────────────────────────────────

model TeacherInviteToken {
  id              String        @id @default(cuid())
  schoolTeacherId String
  schoolTeacher   SchoolTeacher @relation(fields: [schoolTeacherId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  resentAt        DateTime?
  resentCount     Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([schoolTeacherId])
  @@index([expiresAt])
}

// ─── School: Generic Invite Tokens (teacher/admin/parent) ───────────────

model SchoolInviteToken {
  id                    String           @id @default(cuid())
  schoolId              String
  school                School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inviteType            SchoolInviteType
  targetEmail           String
  targetRole            String?
  targetSchoolStudentId String?
  tokenHash             String           @unique
  expiresAt             DateTime
  usedAt                DateTime?
  consumedByUserId      String?
  consumedByUser        User?            @relation("SchoolInviteConsumedBy", fields: [consumedByUserId], references: [id], onDelete: SetNull)
  createdByUserId       String?
  createdByUser         User?            @relation("SchoolInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  metadataJson          String?
  createdAt             DateTime         @default(now())

  @@index([schoolId, inviteType])
  @@index([schoolId, targetEmail])
  @@index([expiresAt])
  @@index([usedAt])
}

// ─── School: Audit Log ────────────────────────────────────────────────────

model SchoolAuditLog {
  id                   String   @id @default(cuid())
  schoolId             String
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorUserId          String?
  action               String // invite_sent | invite_accepted | invite_expired | invite_resent
  // teacher_activated | teacher_suspended | teacher_archived
  // student_enrolled | student_transferred | student_archived
  // login | login_blocked | seat_upgraded | licence_suspended
  // assignment_issued | content_moderation_flag | safeguarding_alert
  entityType           String // teacher | student | classroom | licence | assignment | system
  entityId             String?
  ipAddress            String?
  userAgent            String?
  requestId            String?
  correlationId        String?
  source               String? // ui | api | worker | webhook | system
  operation            String?
  actorType            String? // admin_user | school_staff | system | webhook
  actorAdminUserId     String?
  actorSchoolTeacherId String?
  actorEmail           String?
  impersonatedByUserId String?
  metadataJson         String?
  beforeJson           String?
  afterJson            String?
  diffJson             String?
  tagsJson             String?
  severity             String   @default("info") // info | warning | critical
  createdAt            DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, action])
  @@index([schoolId, operation, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([actorUserId, createdAt])
  @@index([severity, createdAt])
}

// ─── School: Login History ────────────────────────────────────────────────

model SchoolLoginHistory {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // SchoolTeacherRole value or "student"
  success    Boolean
  failReason String? // wrong_password | licence_blocked | account_suspended | etc.
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
}

// ─── School: Access Log ─────────────────────────────────────────────────

model SchoolAccessLog {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolTeacherId String?
  method          String
  route           String
  resourceType    String?
  resourceId      String?
  success         Boolean  @default(true)
  denialReason    String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([schoolTeacherId, createdAt])
  @@index([success, createdAt])
}

// ─── School: Licence Events ─────────────────────────────────────────────

model LicenceEvent {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolLicenceId String?
  eventType       String
  previousStatus  String?
  nextStatus      String?
  actorUserId     String?
  actor           User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadataJson    String?
  createdAt       DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolLicenceId, createdAt])
  @@index([eventType, createdAt])
}

// ─── School: Parent-School Relationship ──────────────────────────────────

model ParentSchoolLink {
  id                      String                         @id @default(cuid())
  schoolId                String
  school                  School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentUserId            String
  parent                  User                           @relation("ParentSchoolLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  schoolStudentId         String
  schoolStudent           SchoolStudent                  @relation(fields: [schoolStudentId], references: [id], onDelete: Cascade)
  // Permissions the school has granted/restricted for this parent
  canReceiveReports       Boolean                        @default(true)
  canMessageTeachers      Boolean                        @default(true)
  consentGivenAt          DateTime?
  consentWithdrawnAt      DateTime?
  status                  String                         @default("active") // active | pending_consent | suspended | removed
  invitedAt               DateTime                       @default(now())
  communicationPreference SchoolCommunicationPreference?
  communicationLogs       SchoolCommunicationLog[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@unique([schoolId, parentUserId, schoolStudentId])
  @@index([schoolId, status])
  @@index([parentUserId])
  @@index([schoolStudentId])
}

model SchoolCommunicationPreference {
  id                     String           @id @default(cuid())
  schoolId               String
  school                 School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentSchoolLinkId     String           @unique
  parentSchoolLink       ParentSchoolLink @relation(fields: [parentSchoolLinkId], references: [id], onDelete: Cascade)
  optedOutAt             DateTime?
  optOutReason           String?
  safeguardingLockedAt   DateTime?
  safeguardingLockReason String?
  updatedByUserId        String?
  updatedBy              User?            @relation("CommunicationPreferenceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([schoolId, updatedAt])
  @@index([optedOutAt])
  @@index([safeguardingLockedAt])
}

model SchoolCommunicationLog {
  id                   String           @id @default(cuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentSchoolLinkId   String
  parentSchoolLink     ParentSchoolLink @relation(fields: [parentSchoolLinkId], references: [id], onDelete: Cascade)
  actorUserId          String?
  actor                User?            @relation("SchoolCommunicationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  channel              String
  subject              String
  messageBody          String
  deliveryStatus       String
  deliveryReason       String?
  safeguardingOverride Boolean          @default(false)
  createdAt            DateTime         @default(now())

  @@index([schoolId, createdAt])
  @@index([parentSchoolLinkId, createdAt])
  @@index([deliveryStatus, createdAt])
}

// ─── School: Safeguarding Alerts ─────────────────────────────────────────

model SchoolSafeguardingAlert {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String?
  student      ChildProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  triggeredBy  String // ai_moderation | teacher_flag | system_rule | parent_report
  category     String // inappropriate_content | distress_signal | unusual_activity | access_anomaly
  severity     String        @default("medium") // low | medium | high | critical
  description  String
  contentRef   String? // e.g. contentId, assignmentId, sessionId
  status       String        @default("open") // open | under_review | resolved | escalated | dismissed
  reviewedBy   String?
  reviewedAt   DateTime?
  resolvedAt   DateTime?
  metadataJson String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, severity])
  @@index([studentId])
  @@index([createdAt])
}

// ─── School: Safeguarding Incidents ─────────────────────────────────────

model SafeguardingIncident {
  id                    String                           @id @default(cuid())
  schoolId              String
  school                School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId             String?
  student               ChildProfile?                    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reportedByUserId      String?
  reportedBy            User?                            @relation("SafeguardingReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  escalationOwnerUserId String?
  escalationOwner       User?                            @relation("SafeguardingEscalationOwner", fields: [escalationOwnerUserId], references: [id], onDelete: SetNull)
  escalationLevel       String?
  category              String
  severity              String                           @default("medium")
  status                String                           @default("open")
  description           String
  actionTaken           String?
  metadataJson          String?
  workflowEvents        SafeguardingWorkflowEvent[]
  evidenceAttachments   SafeguardingEvidenceAttachment[]
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  resolvedAt            DateTime?

  @@index([schoolId, status])
  @@index([schoolId, severity])
  @@index([studentId, createdAt])
  @@index([reportedByUserId, createdAt])
  @@index([escalationOwnerUserId, createdAt])
}

model SafeguardingWorkflowEvent {
  id           String               @id @default(cuid())
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  incidentId   String
  incident     SafeguardingIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actor        User?                @relation("SafeguardingWorkflowActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType    String
  note         String?
  metadataJson String?
  createdAt    DateTime             @default(now())

  @@index([schoolId, createdAt])
  @@index([incidentId, createdAt])
  @@index([eventType, createdAt])
}

model SafeguardingEvidenceAttachment {
  id               String               @id @default(cuid())
  schoolId         String
  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  incidentId       String
  incident         SafeguardingIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedByUserId String?
  uploadedBy       User?                @relation("SafeguardingEvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  label            String
  originalName     String
  storedFilename   String
  publicUrl        String
  mimeType         String?
  fileSizeBytes    Int?
  note             String?
  createdAt        DateTime             @default(now())

  @@index([schoolId, createdAt])
  @@index([incidentId, createdAt])
}

// ─── School Provisioning Jobs (async backend provisioning) ───────────────

model SchoolProvisioningJob {
  id                String                      @id @default(cuid())
  schoolId          String
  school            School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?                       @relation("ProvisioningRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  status            String                      @default("queued") // queued | running | succeeded | failed | retry_scheduled | cancelled | timed_out
  priority          String                      @default("normal") // low | normal | high | critical
  idempotencyKey    String                      @unique
  requestJson       String?
  resultJson        String?
  errorJson         String?
  attemptCount      Int                         @default(0)
  maxAttempts       Int                         @default(3)
  nextRetryAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  stepRuns          SchoolProvisioningStepRun[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([schoolId, createdAt])
  @@index([status, createdAt])
  @@index([nextRetryAt, status])
}

model SchoolProvisioningStepRun {
  id          String                @id @default(cuid())
  jobId       String
  job         SchoolProvisioningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepKey     String
  status      String                @default("pending") // pending | running | completed | failed | skipped
  attempt     Int                   @default(1)
  actorUserId String?
  actor       User?                 @relation("ProvisioningStepActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  inputJson   String?
  outputJson  String?
  errorJson   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([jobId, createdAt])
  @@index([stepKey, status])
}

// ─── MAT / Multi-school Support ──────────────────────────────────────────

model Trust {
  id                      String                   @id @default(cuid())
  name                    String
  code                    String                   @unique
  status                  String                   @default("active") // active | suspended | archived
  headquartersRegion      String?
  metadataJson            String?
  schoolMemberships       TrustSchoolMembership[]
  adminMemberships        TrustAdminMembership[]
  bulkBatches             BulkOnboardingBatch[]
  notificationEvents      NotificationEvent[]
  notificationPreferences NotificationPreference[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([status, createdAt])
}

model TrustSchoolMembership {
  id          String    @id @default(cuid())
  trustId     String
  trust       Trust     @relation(fields: [trustId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleInTrust String? // lead_school | member_school | satellite
  status      String    @default("active") // active | suspended | archived
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([trustId, schoolId])
  @@index([schoolId, status])
  @@index([trustId, status])
}

model TrustAdminMembership {
  id        String   @id @default(cuid())
  trustId   String
  trust     Trust    @relation(fields: [trustId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustRole String   @default("viewer") // owner | admin | operator | viewer
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trustId, userId])
  @@index([userId, status])
  @@index([trustId, status])
}

model BulkOnboardingBatch {
  id              String               @id @default(cuid())
  trustId         String?
  trust           Trust?               @relation(fields: [trustId], references: [id], onDelete: SetNull)
  createdByUserId String?
  sourceType      String               @default("csv") // csv | api | manual
  fileRef         String?
  status          String               @default("draft") // draft | validating | ready | running | completed | failed | cancelled
  totalRows       Int                  @default(0)
  successRows     Int                  @default(0)
  failedRows      Int                  @default(0)
  dryRun          Boolean              @default(true)
  items           BulkOnboardingItem[]
  metadataJson    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([trustId, createdAt])
}

model BulkOnboardingItem {
  id                String              @id @default(cuid())
  batchId           String
  batch             BulkOnboardingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  schoolPayloadJson String
  status            String              @default("pending") // pending | validated | created | failed | skipped
  createdSchoolId   String?
  errorJson         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([batchId, rowNumber])
  @@index([status, createdAt])
  @@index([createdSchoolId])
}

// ─── Notification Infrastructure ─────────────────────────────────────────

model NotificationEvent {
  id          String                 @id @default(cuid())
  eventType   String
  schoolId    String?
  school      School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  trustId     String?
  trust       Trust?                 @relation(fields: [trustId], references: [id], onDelete: SetNull)
  severity    String                 @default("info") // info | warning | critical
  payloadJson String
  dedupeKey   String?
  status      String                 @default("pending") // pending | processing | dispatched | failed | cancelled
  deliveries  NotificationDelivery[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([eventType, createdAt])
  @@index([schoolId, createdAt])
  @@index([trustId, createdAt])
  @@index([status, createdAt])
  @@index([dedupeKey])
}

model NotificationDelivery {
  id                String            @id @default(cuid())
  eventId           String
  event             NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel           String // email | sms | whatsapp
  recipient         String
  status            String            @default("pending") // pending | sent | delivered | failed | skipped
  attempts          Int               @default(0)
  providerMessageId String?
  providerStatus    String?
  lastError         String?
  deliveredByUserId String?
  deliveredBy       User?             @relation("NotificationDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([eventId, createdAt])
  @@index([channel, status, createdAt])
  @@index([recipient, createdAt])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trustId         String?
  trust           Trust?   @relation(fields: [trustId], references: [id], onDelete: Cascade)
  eventType       String? // null means default rule for scope
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  minSeverity     String   @default("info") // info | warning | critical
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([schoolId, userId])
  @@index([trustId, userId])
}

// ─── Human Support Availability & Scheduling v1 ───────────────────────────

enum TutorAvailabilityStatus {
  offline
  available
  busy
  paused
}

enum HumanSupportQueueStatus {
  waiting
  assigned
  in_session
  completed
  cancelled
  paused_ai_only
  recovered
  expired
}

enum HumanSupportSessionStatus {
  active
  completed
  abandoned
  timed_out
  handed_over
}

enum HumanSupportOutcome {
  resolved
  partially_resolved
  unresolved
  escalated
  student_recovered
  period_ended
  disconnected
}

model TutorPresence {
  id                   String                  @id @default(cuid())
  schoolId             String
  school               School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolTeacherId      String                  @unique
  schoolTeacher        SchoolTeacher           @relation(fields: [schoolTeacherId], references: [id], onDelete: Cascade)
  status               TutorAvailabilityStatus @default(offline)
  lastHeartbeatAt      DateTime                @default(now())
  availableSince       DateTime?
  pausedAt             DateTime?
  busySince            DateTime?
  activeSessionId      String?
  dayLessonId          String?
  rollingMedianMinutes Float?
  sessionsCompleted    Int                     @default(0)
  resolutionRate       Float?
  metadataJson         String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([schoolId, status, lastHeartbeatAt])
  @@index([dayLessonId])
}

model HumanSupportQueueEntry {
  id               String                  @id @default(cuid())
  schoolId         String
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  childId          String
  classroomId      String?
  periodId         String?
  assignmentId     String?
  questionKey      String?
  priority         Int                     @default(0)
  status           HumanSupportQueueStatus @default(waiting)
  enqueuedAt       DateTime                @default(now())
  assignedAt       DateTime?
  assignedTutorId  String?
  assignedTutor    SchoolTeacher?          @relation("QueueAssignedTutor", fields: [assignedTutorId], references: [id], onDelete: SetNull)
  expiresAt        DateTime?
  estimatedWaitSec Int?
  budgetMinutes    Int?
  metadataJson     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  session HumanSupportSession?

  @@index([schoolId, status, enqueuedAt])
  @@index([periodId, status])
  @@index([childId, status])
  @@index([assignedTutorId, status])
}

model HumanSupportSession {
  id                   String                    @id @default(cuid())
  schoolId             String
  school               School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  queueEntryId         String                    @unique
  queueEntry           HumanSupportQueueEntry    @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  schoolTeacherId      String
  schoolTeacher        SchoolTeacher             @relation(fields: [schoolTeacherId], references: [id], onDelete: Cascade)
  childId              String
  periodId             String?
  /// Frozen at accept time — never shrink when later students join the queue.
  budgetMinutes        Int
  startedAt            DateTime                  @default(now())
  plannedEndsAt        DateTime?
  endedAt              DateTime?
  extendedAt           DateTime?
  status               HumanSupportSessionStatus @default(active)
  outcome              HumanSupportOutcome?
  outcomeNotes         String?
  unresolvedReportJson String?
  exceededBudget       Boolean                   @default(false)
  metadataJson         String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([schoolId, status, startedAt])
  @@index([schoolTeacherId, status])
  @@index([childId, startedAt])
  @@index([periodId, status])
}

model SchoolSupportPolicy {
  id                     String   @id @default(cuid())
  schoolId               String   @unique
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  minimumSessionMinutes  Int      @default(5)
  maximumSessionMinutes  Int      @default(15)
  closeoutReserveMinutes Int      @default(2)
  heartbeatIntervalSec   Int      @default(25)
  staleAfterSec          Int      @default(75)
  transitionMinutes      Float    @default(0.5)
  /// Controlled grace after shift end while finishing an active human-support session.
  shiftEndGraceMinutes   Int      @default(10)
  metadataJson           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── Tutor shifts, Short Learning windows & bookings ──────────────────────

enum TutorSupportShiftStatus {
  scheduled
  on_shift
  break
  finished
  cancelled
}

enum StudentLearningBookingStatus {
  booked
  confirmed
  attended
  completed
  cancelled
  late_cancelled
  no_show
  expired
}

model TutorSupportShift {
  id                 String                  @id @default(cuid())
  schoolId           String
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolTeacherId    String
  schoolTeacher      SchoolTeacher           @relation(fields: [schoolTeacherId], references: [id], onDelete: Cascade)
  startsAt           DateTime
  endsAt             DateTime
  breakStartsAt      DateTime?
  breakEndsAt        DateTime?
  status             TutorSupportShiftStatus @default(scheduled)
  yearGroupScopeJson String?
  subjectScopeJson   String?
  notes              String?
  published          Boolean                 @default(true)
  createdByTeacherId String?
  createdByTeacher   SchoolTeacher?          @relation("TutorSupportShiftCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?
  metadataJson       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([schoolId, startsAt, endsAt])
  @@index([schoolTeacherId, startsAt])
  @@index([schoolId, status, startsAt])
}

model SchoolLearningWindow {
  id                   String    @id @default(cuid())
  schoolId             String
  school               School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// 0=Sunday … 6=Saturday; null means date-specific override via effectiveFrom/effectiveTo only.
  weekday              Int?
  opensAt              String
  closesAt             String
  allowedDurationsJson String    @default("[90,120]")
  startIntervalMinutes Int       @default(30)
  timezone             String    @default("Europe/London")
  capacityPerSlot      Int       @default(40)
  active               Boolean   @default(true)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  metadataJson         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  bookings StudentLearningBooking[]

  @@index([schoolId, active, weekday])
  @@index([schoolId, effectiveFrom, effectiveTo])
}

model StudentLearningBooking {
  id                       String                       @id @default(cuid())
  schoolId                 String
  school                   School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolStudentId          String
  schoolStudent            SchoolStudent                @relation(fields: [schoolStudentId], references: [id], onDelete: Cascade)
  parentUserId             String
  learningWindowId         String?
  learningWindow           SchoolLearningWindow?        @relation(fields: [learningWindowId], references: [id], onDelete: SetNull)
  startsAt                 DateTime
  endsAt                   DateTime
  durationMinutes          Int
  subject                  String
  learningFocus            String?
  parentNote               String?
  status                   StudentLearningBookingStatus @default(booked)
  confirmedAt              DateTime?
  cancelledAt              DateTime?
  cancellationCategory     String?
  joinedAt                 DateTime?
  completedAt              DateTime?
  noShowAt                 DateTime?
  source                   String                       @default("parent_portal")
  honestyPolicyVersion     String?
  honestyAcknowledgedAt    DateTime?
  subscriptionSnapshotJson String?
  metadataJson             String?
  journeyId                String?
  journey                  ShortLearningJourney?        @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  shortLearningSession     ShortLearningSession?

  @@index([schoolId, startsAt])
  @@index([schoolStudentId, startsAt])
  @@index([parentUserId, startsAt])
  @@index([schoolId, status, startsAt])
  @@index([learningWindowId])
  @@index([journeyId])
}

/// Admin-authored Short Learning journey (review → publish) before student booking use.
/// Uses the same Daytime OpenAI stage engine as Day School — not a second generator.
model ShortLearningJourney {
  id              String                     @id @default(cuid())
  schoolId        String
  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject         String
  yearGroup       String
  durationMinutes Int
  topic           String                     @default("")
  skillFocus      String?
  status          String                     @default("draft")
  // draft | generating | awaiting_review | changes_requested | approved | published | failed | archived | legacy_generated
  version         Int                        @default(1)
  createdBy       String?
  publishedBy     String?
  publishedAt     DateTime?
  metadataJson    String?
  blocks          ShortLearningJourneyBlock[]
  bookings        StudentLearningBooking[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([schoolId, subject, yearGroup, durationMinutes, status])
  @@index([status, publishedAt])
  @@index([schoolId, createdAt])
}

model ShortLearningJourneyBlock {
  id                String              @id @default(cuid())
  journeyId         String
  journey           ShortLearningJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  order             Int
  title             String
  blockType         String
  estimatedMinutes  Int
  daytimeStage      String?
  contentId         String?
  learningObjective String?
  reviewStatus      String              @default("pending")
  // pending | awaiting_review | approved | changes_requested | failed | structural
  metadataJson      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([journeyId, order])
  @@index([journeyId, order])
  @@index([contentId])
}

/// Orchestrated multi-block journey for one Short Learning booking.
/// Content packs are Daytime-engine AIContentCache rows (not a second generator).
model ShortLearningSession {
  id               String                   @id @default(cuid())
  bookingId        String                   @unique
  booking          StudentLearningBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  subject          String
  yearGroup        String
  durationMinutes  Int
  status           String                   @default("planned") // planned | generating | awaiting_review | ready | failed
  currentBlockOrder Int                     @default(0)
  generatedAt      DateTime?
  regeneratedAt    DateTime?
  metadataJson     String?
  blocks           ShortLearningBlock[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, generatedAt])
}

model ShortLearningBlock {
  id                   String               @id @default(cuid())
  sessionId            String
  session              ShortLearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order                Int
  title                String
  blockType            String
  estimatedMinutes     Int
  daytimeStage         String?
  contentId            String?
  learningObjective    String?
  status               String               @default("pending") // pending | ready | skipped | completed
  metadataJson         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([sessionId, order])
  @@index([sessionId, order])
  @@index([contentId])
}

/// Operational complaints workflow (Gate 2). Distinct from safeguarding, which
/// is never routed through the ordinary complaints SLA. School/parent/actor
/// references are stored as plain ids to keep this model fully additive.
model Complaint {
  id                       String          @id @default(cuid())
  reference                String          @unique
  subject                  String
  summary                  String?
  channel                  String          @default("admin") // admin | email | phone | portal
  priority                 String          @default("normal") // low | normal | high | urgent
  status                   String          @default("received") // received | acknowledged | investigating | awaiting_information | resolved | closed
  schoolId                 String?
  parentUserId             String?
  assignedToUserId         String?
  createdByUserId          String?
  receivedAt               DateTime        @default(now())
  acknowledgedAt           DateTime?
  substantiveRespondedAt   DateTime?
  acknowledgementDueAt     DateTime?
  substantiveResponseDueAt DateTime?
  resolution               String?
  resolvedAt               DateTime?
  closedAt                 DateTime?
  metadataJson             String?
  notes                    ComplaintNote[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([status, substantiveResponseDueAt])
  @@index([assignedToUserId, status])
  @@index([schoolId, status])
  @@index([priority, status])
}

model ComplaintNote {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorUserId String?
  kind        String    @default("internal") // investigation | response | internal | status_change
  body        String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

/// Gate 5 — version-controlled policy document (additive CMS).
/// One logical document (slug) with many immutable versions after approval/publish.
model PolicyDocumentRecord {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  category         String          @default("legal") // legal | product | operational | handbook | runbook | knowledge
  audienceJson     String          @default("[\"Public\"]")
  visibility       String          @default("public") // public | internal
  currentVersionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  versions         PolicyVersion[]

  @@index([visibility, category])
}

model PolicyVersion {
  id                  String               @id @default(cuid())
  documentId          String
  document            PolicyDocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version             String
  status              String               @default("draft") // draft | in_review | approved | published | superseded | archived
  effectiveDate       DateTime?
  lastUpdatedAt       DateTime             @default(now())
  authorId            String?
  approvedBy          String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  supersedesId        String?
  contentJson         String
  changeLog           String?
  approvalHistoryJson String               @default("[]")
  requiresAck         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([documentId, version])
  @@index([documentId, status])
  @@index([status, publishedAt])
}

/// Gate 5 — Help / Knowledge Centre articles (public or internal).
model HelpArticleRecord {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  summary           String
  category          String
  audience          String    @default("Parent")
  visibility        String    @default("public") // public | internal
  status            String    @default("draft") // draft | published | archived
  bodyJson          String    @default("[]")
  keywordsJson      String    @default("[]")
  relatedPolicySlug String?
  version           String    @default("1.0.0")
  authorId          String?
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([visibility, status, category])
  @@index([status, publishedAt])
}

/// Bulk educational lesson-pack import jobs (Generator → Content Library draft).
/// Additive only — does not alter AIContentCache / review / publish tables.
model LessonPackImport {
  id                      String   @id @default(cuid())
  status                  String   @default("uploaded") // uploaded | analysing | needs_input | analysis_failed | draft_created | awaiting_review | changes_requested | approved | published | rejected
  createdByUserId         String?
  sessionType             String   @default("school_day") // school_day | short_learning_90 | short_learning_120 | general_library
  sourceName              String?
  sourceUrl               String?
  licenceType             String?
  attribution             String?
  notes                   String?
  yearGroupOverride       String?
  subjectOverride         String?
  difficultyOverride      Int?
  detectedYearGroup       String?
  detectedSubject         String?
  detectedDifficulty      Int?
  yearConfidence          Float?
  subjectConfidence       Float?
  difficultyConfidence    Float?
  sourceFingerprint       String?
  filesJson               String? // uploaded file metadata + classifications (no student PII)
  analysisJson            String? // full analysis / previews
  previewJson             String? // selected lesson preview
  contentId               String? // linked AIContentCache draft id
  duplicateOverrideReason String?
  thirdPartyDecisionsJson String? // admin include/exclude decisions
  errorJson               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
  @@index([sourceFingerprint])
  @@index([createdByUserId])
  @@index([contentId])
}
