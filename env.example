DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
AUTH_SECRET="replace_with_long_random_secret"
API_KEY_ENCRYPTION_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Launch scope (UK / production)
# ---------------------------------------------------------------------------
# When true (default), school-portal routes are gated by LAUNCH_ENABLE_SCHOOL_PORTAL.
# LAUNCH_SCOPE_STRICT=true
#
# Production MUST set these to true when the School Portal / Teacher Portal is live.
# If missing, they default to false and Teachers must not be redirected to /student/dashboard
# (that combination previously caused a /teacher ↔ /student/dashboard loop).
LAUNCH_ENABLE_SCHOOL_PORTAL=true
NEXT_PUBLIC_LAUNCH_ENABLE_SCHOOL_PORTAL=true
#
# Optional public launch flags (default false):
# NEXT_PUBLIC_LAUNCH_ENABLE_ROADMAP=false
# NEXT_PUBLIC_LAUNCH_ENABLE_PUBLIC_TRIAL_CTA=false
# NEXT_PUBLIC_LAUNCH_ENABLE_STUDENT_CERTIFICATES=false

OPENAI_API_KEY=
# AI text generation model used by admin curriculum generator
OPENAI_TEXT_MODEL=gpt-4o-mini
# AI image generation model for lesson visuals (disabled by default)
OPENAI_IMAGE_MODEL=gpt-image-1
# 0/1 flag: enables visual generation pipeline
AI_VISUAL_GENERATION_ENABLED=0
# Visual generation mode: none | planned_only | generate_now
AI_VISUAL_GENERATION_DEFAULT_MODE=planned_only
# Max visuals planned/generated per content item
AI_VISUAL_GENERATION_MAX_PER_CONTENT=2

STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SCHOOL_WEBHOOK_SECRET=whsec_xxx
# After Stripe Dashboard prices exist, map them onto PricingPlan rows:
#   npx tsx scripts/apply-stripe-price-ids.ts
# Enable only when keys + price IDs are configured:
#   BILLING_ENABLE_STRIPE=true

PAYMENT_PROVIDER=stripe
PAYSTACK_SECRET_KEY=

BILLING_DEFAULT_PROVIDER=revolut
BILLING_ENABLE_REVOLUT=true
BILLING_ENABLE_PAYSTACK=true
BILLING_ENABLE_STRIPE=false
BILLING_ENABLE_MANUAL=true

REVOLUT_MERCHANT_API_KEY=
REVOLUT_WEBHOOK_SECRET=
# Optional override. Leave empty to use REVOLUT_ENVIRONMENT-driven defaults.
# Sandbox default: https://sandbox-merchant.revolut.com/api
# Production default: https://merchant.revolut.com/api
REVOLUT_API_BASE_URL=
REVOLUT_ENVIRONMENT=sandbox

PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_ENVIRONMENT=live

TRUENUMERIS_INTEGRATION_ENABLED=false
TRUENUMERIS_DEFAULT_REGION=UK
TRUENUMERIS_WEBHOOK_SECRET=
TRUENUMERIS_REQUEST_TIMEOUT_MS=10000

RESEND_API_KEY=
EMAIL_FROM="StarLiz Academy <onboarding@resend.dev>"

CRON_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

BACKUP_PROVIDER=
DATABASE_BACKUP_URL=
SENTRY_DSN=
MONITORING_DSN=

VOICE_PROVIDER_TEST_URL=
STORAGE_PROVIDER_TEST_URL=

CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_PUBLIC_URL=
# Optional private lesson-pack upload signing (local/dev fallback when R2 is unset)
LESSON_PACK_UPLOAD_SIGNING_SECRET=
LESSON_PACK_STORAGE_DIR=
LESSON_PACK_TEMP_DIR=
