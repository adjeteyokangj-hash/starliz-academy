{
  "name": "starliz-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "prebuild": "npm run test:curriculum-coverage && npm run audit:ai-curriculum && tsx scripts/coding/verify-curriculum-runtime.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "test": "tsx --test tests/csv_escape.test.ts tests/production_flows.test.ts tests/tenant_isolation.test.ts tests/governance_flows.test.ts tests/curriculum_coverage.test.ts tests/ai_generator_validation.test.ts tests/twilio_whatsapp_webhook_signature.test.ts tests/payment_webhook_policy.test.ts tests/human_support_timing.test.ts tests/portal_routing.test.ts tests/short_learning_booking_rules.test.ts tests/support_eligibility.test.ts tests/short_learning_access.test.ts tests/tutor_shift_eligibility.test.ts tests/short_learning_cron.test.ts tests/phase6_policies.test.ts",
    "verify:short-learning-cron": "tsx scripts/verify-short-learning-cron.ts",
    "test:phase6-policies": "tsx --test tests/phase6_policies.test.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:full": "tsc --noEmit",
    "typecheck:launch-modules": "tsc -p tsconfig.launch-modules.json --noEmit",
    "verify:cron-auth": "tsx scripts/verify-cron-auth.ts",
    "apply:stripe-price-ids": "tsx scripts/apply-stripe-price-ids.ts",
    "policy:publication-readiness": "tsx scripts/policy-publication-readiness.ts",
    "uat:short-learning": "tsx scripts/uat-short-learning.ts",
    "uat:admin-portal": "tsx scripts/uat-admin-portal-launch.ts",
    "test:curriculum-coverage": "tsx --test tests/curriculum_coverage.test.ts",
    "audit:ai-curriculum": "tsx scripts/audit_ai_curriculum.ts",
    "test:e2e:assigned-loop": "playwright test tests/e2e/assigned-content-loop.spec.ts",
    "test:e2e:retry-pack": "playwright test tests/e2e/retry-pack-completion.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/auth-session-refresh.spec.ts tests/e2e/parent-profile-gate.spec.ts tests/e2e/parent-shell-routes.spec.ts --workers=1 --reporter=line",
    "test:e2e:auth:trace": "playwright test tests/e2e/auth-session-refresh.spec.ts tests/e2e/parent-profile-gate.spec.ts tests/e2e/parent-shell-routes.spec.ts --workers=1 --trace on --headed",
    "test:e2e:final-smoke": "playwright test tests/e2e/final-smoke-targeted.spec.ts --workers=1",
    "test:e2e:schools-ops": "playwright test --workers=1 tests/e2e/admin-schools-ops.spec.ts tests/e2e/admin-schools-ops-cleanup.spec.ts",
    "test:e2e:schools-ops-cleanup": "playwright test tests/e2e/admin-schools-ops-cleanup.spec.ts",
    "verify:release:core": "npm run audit:launch-env -- --strict && npx tsc --noEmit && npm run lint -- --max-warnings=0 && npm test && npm run build && npm run smoke:routes",
    "verify:release:e2e": "npm run test:e2e:auth && npm run test:e2e:assigned-loop && npm run test:e2e:schools-ops && npm run test:e2e:final-smoke",
    "verify:release": "npm run verify:release:core && npm run verify:release:e2e && npm run report:release-readiness",
    "audit:launch-env": "tsx scripts/audit_launch_env.ts",
    "report:release-readiness": "tsx scripts/release_readiness_report.ts",
    "seed:admin": "node scripts/seed_admin.mjs",
    "prisma:local:studio": "node scripts/prisma_local.mjs studio",
    "prisma:local:pull": "node scripts/prisma_local.mjs pull",
    "prisma:local:generate": "node scripts/prisma_local.mjs generate",
    "migration:export": "tsx scripts/migration_export.ts",
    "migration:import": "tsx scripts/migration_import.ts",
    "migration:sync:prod": "tsx scripts/migrate_local_to_production.ts",
    "seed:ops-scenarios": "prisma db execute --file ./scripts/seed_ops_scenarios.sql",
    "cleanup:ops-scenarios": "prisma db execute --file ./scripts/cleanup_ops_scenarios.sql",
    "smoke:routes": "node scripts/smoke_routes.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "blockly": "13.4.0",
    "busboy": "^1.6.0",
    "codemirror": "6.0.2",
    "imapflow": "^1.7.8",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "^16.4.4",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.3.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
