[Unit]
Description=StarLiz isolated code execution broker
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
User=starliz-coding-runner
Group=starliz-coding-runner
SupplementaryGroups=docker
WorkingDirectory=/opt/starliz-coding-runner
EnvironmentFile=/etc/starliz-coding-runner.env
ExecStart=/usr/bin/node /opt/starliz-coding-runner/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
MemoryMax=512M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
