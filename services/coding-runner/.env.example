# Generate a unique >=32-character secret. Share only with the StarLiz backend.
CODING_RUNNER_SECRET=
CODING_RUNNER_BIND=127.0.0.1
CODING_RUNNER_PORT=4319
CODING_RUNNER_MODE=production
CODING_RUNNER_CONTAINER_RUNTIME=runsc
# Immutable, reviewed images already present on the dedicated runner host.
# Values must include @sha256:<64 hex characters>; mutable tags are rejected.
CODING_RUNNER_PYTHON_IMAGE=
CODING_RUNNER_JAVASCRIPT_IMAGE=
# Optional, separate pinned image for authenticated private-video decoding.
CODING_RUNNER_MEDIA_IMAGE=
