# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.playwright-browsers/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-startup.log
*.log

# env files (can opt-in for committing if needed)
.env*
env
dev.db
prisma/dev.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local workspace artifacts
.eslintcache
.vscode/mcp.json
.dev-port-check.txt
/tmp/
package.json.full-backup.json
package.json.surgical-backup.json
package.json.tmp.defect.json
run-playable-report.mts
scripts/_direct_storage_uat.mts
scripts/_disposition_uat_draft.mts
scripts/_oak_diagnose.mts
scripts/uat/_tmp-*

# Generated launch-verification evidence (regenerate via npm scripts)
/artifacts/uat/**
!/artifacts/uat/.gitkeep
/artifacts/screenshots/**
!/artifacts/screenshots/.gitkeep
/artifacts/generated/**
!/artifacts/generated/.gitkeep
scripts/.uat-*.json
scripts/.verify-*-evidence.json
